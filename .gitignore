# .gitignore
.env
.venv/
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/

# Bronze data (regenerated by ingest scripts, never committed)
bronze/

# MLflow runs
mlruns/

# DuckDB scratch files
*.duckdb
*.duckdb.wal

# dbt artefacts
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Streamlit cache
.streamlit/

# IDE
.vscode/
.idea/

# Build artefacts
report/figures/*.png
!report/figures/.gitkeep
